
{
  "info": {
    "name": "Job Portal API",
    "description": "Postman collection for testing the Job Portal REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Employer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Employer\",\n  \"email\": \"employer@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"employer\",\n  \"companyName\": \"Test Technologies\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employer@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Get All Jobs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/jobs"
          }
        },
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Junior Python Developer\",\n  \"description\": \"Develop backend APIs.\",\n  \"companyName\": \"Test Technologies\",\n  \"location\": \"Pune\",\n  \"type\": \"full-time\",\n  \"salary\": 30000,\n  \"skills\": [\"Python\", \"FastAPI\", \"SQL\"]\n}"
            },
            "url": "{{baseUrl}}/api/jobs"
          }
        },
        {
          "name": "Search Jobs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/jobs?location=Pune&type=full-time&page=1&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs"],
              "query": [
                {"key": "location", "value": "Pune"},
                {"key": "type", "value": "full-time"},
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "5"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "My Applications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/applications/my"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ]
}
